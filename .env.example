# Neon/PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional. Set automatically by Vercel/Next in most environments.
NODE_ENV="development"

# Paystack billing. Use test keys locally and live keys only in production.
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Product analytics. PostHog is optional locally; set these before scaling.
NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Internal admin dashboard. Required in production for /admin access.
ADMIN_EMAILS="owner@example.com,ops@example.com"

# Password reset emails. EMAIL_FROM must be a sender/domain verified in Resend.
RESEND_API_KEY="re_xxx"
EMAIL_FROM="SME MoneyBook <admin@smemoneybook.com>"

# Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="choose-a-long-random-token"
WHATSAPP_BUSINESS_ACCOUNT_ID="1234567890"
# Optional approved Meta template for owner low-stock alerts.
# Body variables: {{1}} business, {{2}} product, {{3}} quantity, {{4}} alert level.
WHATSAPP_LOW_STOCK_TEMPLATE_NAME="low_stock_alert"
WHATSAPP_LOW_STOCK_TEMPLATE_LANGUAGE="en"
# Optional but recommended for POST webhook signature validation.
WHATSAPP_APP_SECRET="your-meta-app-secret"

# OpenAI assistant.
OPENAI_API_KEY="sk-proj_xxx"
OPENAI_MODEL="gpt-4.1-mini"

# Vercel Cron / automation runner.
CRON_SECRET="choose-a-long-random-cron-secret"

# Phase 2 rollout flags. Keep disabled until entitlement, QA, and support docs are ready.
NEXT_PUBLIC_PHASE2_LOCATIONS_ENABLED="false"
NEXT_PUBLIC_PHASE2_TRANSFERS_ENABLED="false"
NEXT_PUBLIC_PHASE2_REPORTING_CENTRE_ENABLED="false"
NEXT_PUBLIC_PHASE2_PDF_EXPORTS_ENABLED="false"
NEXT_PUBLIC_PHASE2_TAX_ENABLED="false"
NEXT_PUBLIC_PHASE2_INVOICE_BRANDING_ENABLED="false"
NEXT_PUBLIC_PHASE2_I18N_ENABLED="false"
NEXT_PUBLIC_PHASE2_GRANULAR_PERMISSIONS_ENABLED="false"
NEXT_PUBLIC_PHASE2_ANNOUNCEMENTS_ENABLED="false"
NEXT_PUBLIC_PHASE2_BUSINESS_SWITCHER_ENABLED="false"

# Phase 3 AI operating-system rollout flags. Keep disabled until each wave has
# governance, authorization, cost controls, monitoring, and QA approval.
NEXT_PUBLIC_PHASE3_AI_ADVISOR_ENABLED="false"
NEXT_PUBLIC_PHASE3_HEALTH_SCORE_ENABLED="false"
NEXT_PUBLIC_PHASE3_EXECUTIVE_DASHBOARD_ENABLED="false"
NEXT_PUBLIC_PHASE3_CASHFLOW_FORECASTS_ENABLED="false"
NEXT_PUBLIC_PHASE3_INVENTORY_FORECASTING_ENABLED="false"
NEXT_PUBLIC_PHASE3_PREDICTIVE_ALERTS_ENABLED="false"
NEXT_PUBLIC_PHASE3_BANK_RECONCILIATION_ENABLED="false"
NEXT_PUBLIC_PHASE3_TAX_ASSISTANT_ENABLED="false"
NEXT_PUBLIC_PHASE3_LOAN_READINESS_ENABLED="false"
NEXT_PUBLIC_PHASE3_COOPERATIVES_ENABLED="false"
NEXT_PUBLIC_PHASE3_PAYROLL_ENABLED="false"
NEXT_PUBLIC_PHASE3_STAFF_PERFORMANCE_ENABLED="false"
NEXT_PUBLIC_PHASE3_WHATSAPP_AUTOMATION_ENABLED="false"
NEXT_PUBLIC_PHASE3_AI_MARKETING_ENABLED="false"
NEXT_PUBLIC_PHASE3_AI_EVALUATION_ENABLED="false"
NEXT_PUBLIC_PHASE3_ADMIN_AI_OPS_ENABLED="false"

# Server-side Phase 3 controls.
PHASE3_AI_GLOBAL_KILL_SWITCH="false"
PHASE3_AI_MONTHLY_COST_BUDGET_KOBO="0"
PHASE3_AI_DAILY_REQUEST_LIMIT_PER_BUSINESS="0"
