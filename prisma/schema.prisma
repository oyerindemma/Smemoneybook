  reversalReason  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location        BusinessLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items           PayrollRunItem[]
  journalEntries  PayrollJournalEntry[]

  @@index([businessId, status, periodStart])
  @@index([businessId, locationId, periodStart])
  @@index([businessId, lockedAt])
}

model PayrollRunItem {
  id                    String                @id @default(cuid())
  businessId            String
  runId                 String
  employeeId            String
  basePay               Decimal               @default(0)
  allowances            Json
  bonuses               Json
  deductions            Json
  loansAndAdvances      Json
  grossPay              Decimal               @default(0)
  pensionEmployeeAmount Decimal               @default(0)
  pensionEmployerAmount Decimal               @default(0)
  taxAmount             Decimal               @default(0)
  netPay                Decimal               @default(0)
  paymentStatus         String                @default("UNPAID")
  payslipAccessHash     String?
  lockedAt              DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  run                   PayrollRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee              PayrollEmployee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  journalEntries        PayrollJournalEntry[]

  @@index([businessId, runId])
  @@index([businessId, employeeId])
  @@index([runId, paymentStatus])
}

model PayrollJournalEntry {
  id            String          @id @default(cuid())
  businessId    String
  runId         String
  itemId        String?
  transactionId String?
  entryType     String
  amount        Decimal         @default(0)
  status        String          @default("PENDING")
  createdById   String?
  createdAt     DateTime        @default(now())
  run           PayrollRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  item          PayrollRunItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([businessId, runId, status])
  @@index([businessId, transactionId])
  @@index([runId, entryType])
}

model StaffPerformanceGoal {
  id           String            @id @default(cuid())
  businessId   String
  locationId   String?
  staffUserId  String?
  label        String
  metric       String
  targetValue  Decimal           @default(0)
  currentValue Decimal?
  periodStart  DateTime
  periodEnd    DateTime
  status       String            @default("ACTIVE")
  createdById  String?
  achievedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location     BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([businessId, status, periodStart])
  @@index([businessId, staffUserId, periodStart])
  @@index([businessId, locationId, periodStart])
}

model StaffPerformanceSnapshot {
  id             String            @id @default(cuid())
  businessId     String
  locationId     String?
  staffUserId    String?
  formulaVersion String
  periodStart    DateTime
  periodEnd      DateTime
  generatedAt    DateTime          @default(now())
  metrics        Json
  goals          Json
  warnings       Json
  sourceMetrics  Json
  createdAt      DateTime          @default(now())
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location       BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([businessId, generatedAt])
  @@index([businessId, staffUserId, generatedAt])
  @@index([businessId, locationId, generatedAt])
  @@index([businessId, formulaVersion, generatedAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

