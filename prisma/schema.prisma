generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  password                String
  pinHash                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  members                 BusinessMember[]
  auditLogs               AuditLog[]
  sessions                Session[]
  passwordResets          PasswordResetToken[]
  sentInvitations         BusinessInvitation[]     @relation("InvitationSender")
  DebtEvent               DebtEvent[]
  ReportSnapshot          ReportSnapshot[]
  subscriptions           Subscription[]
  assistantThreads        AssistantThread[]
  assistantMessages       AssistantMessage[]
  pendingAssistantActions PendingAssistantAction[]
  referralAttributions    ReferralAttribution[]    @relation("ReferredUser")
  referralRewards         ReferralReward[]         @relation("ReferralRewardUser")
  onboardingProgress      OnboardingProgress?
  onboardingEvents        OnboardingEvent[]
  inventoryMovements      InventoryMovement[]
  offlineSyncOperations   OfflineSyncOperation[]
  locationMemberships     BusinessLocationMember[]
  stockTransfersCreated   StockTransfer[]          @relation("StockTransferCreatedBy")
  stockTransfersApproved  StockTransfer[]          @relation("StockTransferApprovedBy")
  stockTransfersSent      StockTransfer[]          @relation("StockTransferSentBy")
  stockTransfersReceived  StockTransfer[]          @relation("StockTransferReceivedBy")
  language                String                   @default("en")
  exportJobs              ExportJob[]              @relation("ExportJobActor")
  issuedDocuments         IssuedDocument[]          @relation("IssuedDocumentActor")
  announcementReads       AnnouncementRead[]
  announcementsCreated    Announcement[]           @relation("AnnouncementCreator")
  permissionOverrides     PermissionOverride[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                      String                   @id @default(cuid())
  name                    String
  businessCategory        String?
  businessType            String?
  onboardingCompleted     Boolean                  @default(false)
  country                 String                   @default("NG")
  currency                String                   @default("NGN")
  defaultLanguage         String                   @default("en")
  vatRate                 Decimal                  @default(7.5)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  members                 BusinessMember[]
  accounts                Account[]
  customers               Customer[]
  suppliers               Supplier[]
  transactions            Transaction[]
  debts                   Debt[]
  items                   InventoryItem[]
  taxRuns                 TaxRun[]
  reportSnapshots         ReportSnapshot[]
  auditLogs               AuditLog[]
  inventoryMovements      InventoryMovement[]
  invitations             BusinessInvitation[]
  apiErrors               ApiErrorLog[]
  receipts                Receipt[]
  subscriptions           Subscription[]
  offlineCaptures         OfflineCapture[]
  whatsappMessages        WhatsAppMessage[]
  whatsappEvents          WhatsAppEvent[]
  messagePreferences      MessagePreference?
  assistantThreads        AssistantThread[]
  automationPreference    AutomationPreference?
  automationLogs          AutomationLog[]
  pendingAssistantActions PendingAssistantAction[]
  referralAttributions    ReferralAttribution[]    @relation("ReferrerBusiness")
  referredAttributions    ReferralAttribution[]    @relation("ReferredBusiness")
  referralRewards         ReferralReward[]
  onboardingProgress      OnboardingProgress?
  onboardingEvents        OnboardingEvent[]
  productUnits            ProductUnit[]
  productCategories       ProductCategory[]
  productBrands           ProductBrand[]
  transactionPayments     TransactionPayment[]
  receiptConfig           ReceiptConfig?
  customerReturns         CustomerReturn[]
  supplierReturns         SupplierReturn[]
  offlineSyncOperations   OfflineSyncOperation[]
  locations               BusinessLocation[]
  locationMemberships     BusinessLocationMember[]
  inventoryBalances       InventoryBalance[]
  stockTransfers          StockTransfer[]
  exportJobs              ExportJob[]
  taxConfig               TaxConfig?
  taxRates                TaxRate[]
  documentBranding        DocumentBrandingConfig?
  issuedDocuments         IssuedDocument[]
  documentTaxSnapshots    DocumentTaxSnapshot[]
  permissionPolicies      PermissionPolicy[]
  permissionOverrides     PermissionOverride[]
}

model ReferralAttribution {
  id                 String           @id @default(cuid())
  referralCode       String
  referrerBusinessId String?
  referredUserId     String           @unique
  referredBusinessId String?
  source             String           @default("signup")
  status             String           @default("SIGNED_UP")
  createdAt          DateTime         @default(now())
  referrerBusiness   Business?        @relation("ReferrerBusiness", fields: [referrerBusinessId], references: [id], onDelete: SetNull)
  referredBusiness   Business?        @relation("ReferredBusiness", fields: [referredBusinessId], references: [id], onDelete: SetNull)
  referredUser       User             @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  rewards            ReferralReward[]

  @@index([referralCode, createdAt])
  @@index([referrerBusinessId, createdAt])
  @@index([referredBusinessId])
}

model ReferralReward {
  id                    String               @id @default(cuid())
  attributionId         String?
  beneficiaryUserId     String?
  beneficiaryBusinessId String?
  type                  String
  status                String               @default("PENDING")
  description           String
  value                 Int?
  createdAt             DateTime             @default(now())
  redeemedAt            DateTime?
  attribution           ReferralAttribution? @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  beneficiaryUser       User?                @relation("ReferralRewardUser", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  beneficiaryBusiness   Business?            @relation(fields: [beneficiaryBusinessId], references: [id], onDelete: SetNull)

  @@index([beneficiaryUserId, status])
  @@index([beneficiaryBusinessId, status])
  @@index([type, createdAt])
}

model BusinessMember {
  id         String   @id @default(cuid())
  role       Role     @default(OWNER)
  userId     String
  businessId String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model BusinessInvitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(STAFF)
  token       String    @unique
  businessId  String
  invitedById String
  acceptedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([businessId, email])
}

model BusinessLocation {
  id                    String                   @id @default(cuid())
  name                  String
  type                  BusinessLocationType     @default(MAIN_SHOP)
  address               String?
  phone                 String?
  email                 String?
  isDefault             Boolean                  @default(false)
  archivedAt            DateTime?
  businessId            String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members               BusinessLocationMember[]
  inventoryBalances     InventoryBalance[]
  transactions          Transaction[]
  transactionPayments   TransactionPayment[]
  movements             InventoryMovement[]      @relation("MovementLocation")
  sourceMovements       InventoryMovement[]      @relation("MovementSourceLocation")
  destinationMovements  InventoryMovement[]      @relation("MovementDestinationLocation")
  customerReturns       CustomerReturn[]
  supplierReturns       SupplierReturn[]
  reportSnapshots       ReportSnapshot[]
  receiptConfigs        ReceiptConfig[]
  sourceTransfers       StockTransfer[]          @relation("TransferSourceLocation")
  destinationTransfers  StockTransfer[]          @relation("TransferDestinationLocation")
  exportJobs            ExportJob[]
  taxConfigs            TaxConfig[]
  taxRates              TaxRate[]
  documentBranding      DocumentBrandingConfig[]
  issuedDocuments       IssuedDocument[]
  permissionOverrides   PermissionOverride[]

  @@unique([businessId, name])
  @@index([businessId, isDefault])
  @@index([businessId, archivedAt])
  @@index([type])
}

model BusinessLocationMember {
  id         String           @id @default(cuid())
  role       Role             @default(STAFF)
  userId     String
  businessId String
  locationId String
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location   BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([locationId, userId])
  @@index([businessId, userId])
  @@index([businessId, locationId])
}

model Account {
  id                  String               @id @default(cuid())
  name                String
  type                AccountType
  openingBalance      Decimal              @default(0)
  balance             Decimal              @default(0)
  businessId          String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions        Transaction[]        @relation("TransactionAccount")
  transferReceipts    Transaction[]        @relation("TransferDestination")
  inventoryMovement   InventoryMovement[]
  transactionPayments TransactionPayment[]

  @@index([businessId, createdAt])
}

model Transaction {
  id                          String               @id @default(cuid())
  idempotencyKey              String
  duplicateFingerprint        String?
  type                        TransactionType
  amount                      Decimal
  costOfGoods                 Decimal              @default(0)
  profit                      Decimal              @default(0)
  description                 String
  category                    String?
  paymentStatus               PaymentStatus        @default(PAID)
  occurredAt                  DateTime             @default(now())
  businessId                  String
  accountId                   String
  destinationAccountId        String?
  locationId                  String?
  customerId                  String?
  supplierId                  String?
  inventoryItemId             String?
  inventoryQuantity           Int?
  invoiceItems                Json?
  reversesTransactionId       String?              @unique
  business                    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account                     Account              @relation("TransactionAccount", fields: [accountId], references: [id])
  destinationAccount          Account?             @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  location                    BusinessLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer                    Customer?            @relation(fields: [customerId], references: [id])
  supplier                    Supplier?            @relation(fields: [supplierId], references: [id])
  inventoryItem               InventoryItem?       @relation(fields: [inventoryItemId], references: [id])
  reversesTransaction         Transaction?         @relation("TransactionReversal", fields: [reversesTransactionId], references: [id])
  reversalTransaction         Transaction?         @relation("TransactionReversal")
  debts                       Debt[]
  inventoryMovements          InventoryMovement[]
  payments                    TransactionPayment[]
  customerReturnsAsOriginal   CustomerReturn[]     @relation("CustomerReturnOriginal")
  customerReturnsAsRefund     CustomerReturn[]     @relation("CustomerReturnRefund")
  supplierReturnsAsOriginal   SupplierReturn[]     @relation("SupplierReturnOriginal")
  supplierReturnsAsSettlement SupplierReturn[]     @relation("SupplierReturnSettlement")
  taxSnapshots                DocumentTaxSnapshot[]

  @@unique([businessId, idempotencyKey])
  @@unique([businessId, duplicateFingerprint])
  @@index([businessId, occurredAt])
  @@index([businessId, locationId, occurredAt])
}

model Customer {
  id           String           @id @default(cuid())
  name         String
  phone        String?
  businessId   String
  createdAt    DateTime         @default(now())
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  debts        Debt[]
  returns      CustomerReturn[]
  issuedDocuments IssuedDocument[]

  @@index([businessId, createdAt])
  @@index([businessId, name])
}

model Supplier {
  id           String           @id @default(cuid())
  name         String
  phone        String?
  businessId   String
  createdAt    DateTime         @default(now())
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  debts        Debt[]
  returns      SupplierReturn[]

  @@index([businessId, createdAt])
  @@index([businessId, name])
}

model ProductUnit {
  id                    String          @id @default(cuid())
  name                  String
  singularLabel         String
  pluralLabel           String
  allowsDecimal         Boolean         @default(false)
  isDefault             Boolean         @default(false)
  archivedAt            DateTime?
  businessId            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  business              Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItems        InventoryItem[] @relation("InventoryUnit")
  baseInventoryItems    InventoryItem[] @relation("InventoryBaseUnit")
  sellingInventoryItems InventoryItem[] @relation("InventorySellingUnit")

  @@unique([businessId, name])
  @@index([businessId, archivedAt])
}

model ProductCategory {
  id         String          @id @default(cuid())
  name       String
  archivedAt DateTime?
  businessId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      InventoryItem[]

  @@unique([businessId, name])
  @@index([businessId, archivedAt, name])
}

model ProductBrand {
  id         String          @id @default(cuid())
  name       String
  archivedAt DateTime?
  businessId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      InventoryItem[]

  @@unique([businessId, name])
  @@index([businessId, archivedAt, name])
}

model Debt {
  id                  String      @id @default(cuid())
  type                DebtType
  amount              Decimal
  paidAmount          Decimal     @default(0)
  status              DebtStatus  @default(OPEN)
  dueAt               DateTime?
  businessId          String
  customerId          String?
  supplierId          String?
  sourceTransactionId String
  createdAt           DateTime    @default(now())
  business            Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer?   @relation(fields: [customerId], references: [id])
  supplier            Supplier?   @relation(fields: [supplierId], references: [id])
  sourceTransaction   Transaction @relation(fields: [sourceTransactionId], references: [id])
  events              DebtEvent[]

  @@index([businessId, status])
  @@index([businessId, status, createdAt])
  @@index([customerId, status])
  @@index([supplierId, status])
}

model DebtEvent {
  id        String        @id @default(cuid())
  type      DebtEventType
  amount    Decimal?
  note      String?
  channel   String?
  debtId    String
  actorId   String?
  createdAt DateTime      @default(now())
  debt      Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  actor     User?         @relation(fields: [actorId], references: [id])

  @@index([debtId, createdAt])
}

model InventoryItem {
  id                    String               @id @default(cuid())
  name                  String
  sku                   String?
  barcode               String?
  internalCode          String?
  sellingPrice          Decimal
  costPrice             Decimal
  quantityOnHand        Int                  @default(0)
  quantityOnHandDecimal Decimal              @default(0)
  lowStockLevel         Int                  @default(5)
  lowStockLevelDecimal  Decimal              @default(5)
  unitId                String?
  baseUnitId            String?
  sellingUnitId         String?
  conversionFactor      Decimal?
  categoryId            String?
  brandId               String?
  archivedAt            DateTime?
  businessId            String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  unit                  ProductUnit?         @relation("InventoryUnit", fields: [unitId], references: [id], onDelete: SetNull)
  baseUnit              ProductUnit?         @relation("InventoryBaseUnit", fields: [baseUnitId], references: [id], onDelete: SetNull)
  sellingUnit           ProductUnit?         @relation("InventorySellingUnit", fields: [sellingUnitId], references: [id], onDelete: SetNull)
  category              ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                 ProductBrand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  movements             InventoryMovement[]
  transactions          Transaction[]
  customerReturnItems   CustomerReturnItem[]
  supplierReturnItems   SupplierReturnItem[]
  locationBalances      InventoryBalance[]
  transferItems         StockTransferItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@unique([businessId, internalCode])
  @@index([businessId, updatedAt])
  @@index([businessId, createdAt])
  @@index([businessId, categoryId])
  @@index([businessId, brandId])
  @@index([businessId, archivedAt])
}

model InventoryBalance {
  id                    String           @id @default(cuid())
  quantityOnHandDecimal Decimal          @default(0)
  lowStockLevelDecimal  Decimal          @default(5)
  businessId            String
  locationId            String
  inventoryItemId       String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location              BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inventoryItem         InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([businessId, locationId, inventoryItemId])
  @@index([businessId, locationId])
  @@index([inventoryItemId])
}

model InventoryMovement {
  id                    String                @id @default(cuid())
  type                  InventoryMovementType
  quantity              Int
  quantityDecimal       Decimal               @default(0)
  beforeQuantityDecimal Decimal?
  afterQuantityDecimal  Decimal?
  adjustmentType        StockAdjustmentType?
  reason                String?
  note                  String?
  attachmentUrl         String?
  idempotencyKey        String?
  businessId            String?
  actorId               String?
  itemId                String
  accountId             String?
  locationId            String?
  sourceLocationId      String?
  destinationLocationId String?
  transactionId         String?
  createdAt             DateTime              @default(now())
  item                  InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  account               Account?              @relation(fields: [accountId], references: [id])
  transaction           Transaction?          @relation(fields: [transactionId], references: [id])
  business              Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor                 User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)
  location              BusinessLocation?     @relation("MovementLocation", fields: [locationId], references: [id], onDelete: SetNull)
  sourceLocation        BusinessLocation?     @relation("MovementSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationLocation   BusinessLocation?     @relation("MovementDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([itemId, createdAt])
  @@index([accountId, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, adjustmentType, createdAt])
  @@index([businessId, locationId, createdAt])
  @@index([businessId, sourceLocationId, createdAt])
  @@index([businessId, destinationLocationId, createdAt])
}

model TransactionPayment {
  id             String        @id @default(cuid())
  method         PaymentMethod
  amount         Decimal
  note           String?
  idempotencyKey String?
  businessId     String
  accountId      String?
  locationId     String?
  transactionId  String
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  location       BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  transaction    Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([transactionId])
  @@index([accountId, createdAt])
  @@index([businessId, locationId, createdAt])
}

model CustomerReturn {
  id                    String                @id @default(cuid())
  idempotencyKey        String
  reason                String
  disposition           ReturnDisposition
  outcome               CustomerReturnOutcome
  refundAmount          Decimal               @default(0)
  note                  String?
  businessId            String
  locationId            String?
  customerId            String?
  originalTransactionId String
  refundTransactionId   String?
  actorId               String?
  createdAt             DateTime              @default(now())
  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location              BusinessLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  originalTransaction   Transaction           @relation("CustomerReturnOriginal", fields: [originalTransactionId], references: [id])
  refundTransaction     Transaction?          @relation("CustomerReturnRefund", fields: [refundTransactionId], references: [id])
  items                 CustomerReturnItem[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, locationId, createdAt])
  @@index([originalTransactionId])
  @@index([customerId, createdAt])
}

model CustomerReturnItem {
  id               String         @id @default(cuid())
  quantity         Decimal
  unitPrice        Decimal
  total            Decimal
  inventoryItemId  String
  customerReturnId String
  inventoryItem    InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  customerReturn   CustomerReturn @relation(fields: [customerReturnId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([customerReturnId])
}

model SupplierReturn {
  id                      String                   @id @default(cuid())
  idempotencyKey          String
  reason                  String
  settlement              SupplierReturnSettlement
  settlementAmount        Decimal                  @default(0)
  note                    String?
  businessId              String
  locationId              String?
  supplierId              String?
  originalTransactionId   String?
  settlementTransactionId String?
  actorId                 String?
  createdAt               DateTime                 @default(now())
  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location                BusinessLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier                Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  originalTransaction     Transaction?             @relation("SupplierReturnOriginal", fields: [originalTransactionId], references: [id])
  settlementTransaction   Transaction?             @relation("SupplierReturnSettlement", fields: [settlementTransactionId], references: [id])
  items                   SupplierReturnItem[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, locationId, createdAt])
  @@index([supplierId, createdAt])
  @@index([originalTransactionId])
}

model SupplierReturnItem {
  id               String         @id @default(cuid())
  quantity         Decimal
  unitCost         Decimal
  total            Decimal
  inventoryItemId  String
  supplierReturnId String
  inventoryItem    InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  supplierReturn   SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([supplierReturnId])
}

model StockTransfer {
  id                    String              @id @default(cuid())
  transferNumber        String
  status                StockTransferStatus @default(DRAFT)
  reason                String?
  reference             String?
  idempotencyKey        String?
  businessId            String
  sourceLocationId      String
  destinationLocationId String
  createdById           String?
  approvedById          String?
  sentById              String?
  receivedById          String?
  approvedAt            DateTime?
  sentAt                DateTime?
  receivedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceLocation        BusinessLocation    @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation   BusinessLocation    @relation("TransferDestinationLocation", fields: [destinationLocationId], references: [id])
  createdBy             User?               @relation("StockTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy            User?               @relation("StockTransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  sentBy                User?               @relation("StockTransferSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  receivedBy            User?               @relation("StockTransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  items                 StockTransferItem[]

  @@unique([businessId, transferNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
  @@index([businessId, sourceLocationId, createdAt])
  @@index([businessId, destinationLocationId, createdAt])
}

model StockTransferItem {
  id                String        @id @default(cuid())
  requestedQuantity Decimal
  sentQuantity      Decimal       @default(0)
  receivedQuantity  Decimal       @default(0)
  damagedQuantity   Decimal       @default(0)
  shortageQuantity  Decimal       @default(0)
  note              String?
  transferId        String
  inventoryItemId   String
  transfer          StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([transferId, inventoryItemId])
  @@index([inventoryItemId])
}

model ReceiptConfig {
  id               String   @id @default(cuid())
  businessId       String   @unique
  locationId       String?
