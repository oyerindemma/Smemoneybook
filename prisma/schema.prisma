generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  name            String
  email           String               @unique
  password        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  members         BusinessMember[]
  auditLogs       AuditLog[]
  sessions        Session[]
  sentInvitations BusinessInvitation[] @relation("InvitationSender")
  DebtEvent       DebtEvent[]
  ReportSnapshot  ReportSnapshot[]
  subscriptions   Subscription[]
  assistantThreads AssistantThread[]
  assistantMessages AssistantMessage[]
  pendingAssistantActions PendingAssistantAction[]
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                  String               @id @default(cuid())
  name                String
  businessType        String?
  onboardingCompleted Boolean              @default(false)
  country             String               @default("NG")
  currency            String               @default("NGN")
  vatRate             Decimal              @default(7.5)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  members             BusinessMember[]
  accounts            Account[]
  customers           Customer[]
  suppliers           Supplier[]
  transactions        Transaction[]
  debts               Debt[]
  items               InventoryItem[]
  taxRuns             TaxRun[]
  reportSnapshots     ReportSnapshot[]
  auditLogs           AuditLog[]
  invitations         BusinessInvitation[]
  apiErrors           ApiErrorLog[]
  receipts            Receipt[]
  subscriptions       Subscription[]
  offlineCaptures     OfflineCapture[]
  whatsappMessages    WhatsAppMessage[]
  whatsappEvents      WhatsAppEvent[]
  messagePreferences  MessagePreference?
  assistantThreads    AssistantThread[]
  automationPreference AutomationPreference?
  automationLogs      AutomationLog[]
  pendingAssistantActions PendingAssistantAction[]
}

model BusinessMember {
  id         String   @id @default(cuid())
  role       Role     @default(OWNER)
  userId     String
  businessId String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model BusinessInvitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(STAFF)
  token       String    @unique
  businessId  String
  invitedById String
  acceptedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([businessId, email])
}

model Account {
  id                String              @id @default(cuid())
  name              String
  type              AccountType
  openingBalance    Decimal             @default(0)
  balance           Decimal             @default(0)
  businessId        String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions      Transaction[]       @relation("TransactionAccount")
  transferReceipts  Transaction[]       @relation("TransferDestination")
  inventoryMovement InventoryMovement[]

  @@index([businessId, createdAt])
}

model Transaction {
  id                    String              @id @default(cuid())
  idempotencyKey        String
  duplicateFingerprint  String?
  type                  TransactionType
  amount                Decimal
  costOfGoods           Decimal             @default(0)
  profit                Decimal             @default(0)
  description           String
  category              String?
  paymentStatus         PaymentStatus       @default(PAID)
  occurredAt            DateTime            @default(now())
  businessId            String
  accountId             String
  destinationAccountId  String?
  customerId            String?
  supplierId            String?
  inventoryItemId       String?
  inventoryQuantity     Int?
  reversesTransactionId String?             @unique
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account               Account             @relation("TransactionAccount", fields: [accountId], references: [id])
  destinationAccount    Account?            @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  customer              Customer?           @relation(fields: [customerId], references: [id])
  supplier              Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryItem         InventoryItem?      @relation(fields: [inventoryItemId], references: [id])
  reversesTransaction   Transaction?        @relation("TransactionReversal", fields: [reversesTransactionId], references: [id])
  reversalTransaction   Transaction?        @relation("TransactionReversal")
  debts                 Debt[]
  inventoryMovements    InventoryMovement[]

  @@unique([businessId, idempotencyKey])
  @@unique([businessId, duplicateFingerprint])
  @@index([businessId, occurredAt])
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  businessId   String
  createdAt    DateTime      @default(now())
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  debts        Debt[]

  @@index([businessId, createdAt])
  @@index([businessId, name])
}

model Supplier {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  businessId   String
  createdAt    DateTime      @default(now())
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  debts        Debt[]

  @@index([businessId, createdAt])
  @@index([businessId, name])
}

model Debt {
  id                  String      @id @default(cuid())
  type                DebtType
  amount              Decimal
  paidAmount          Decimal     @default(0)
  status              DebtStatus  @default(OPEN)
  dueAt               DateTime?
  businessId          String
  customerId          String?
  supplierId          String?
  sourceTransactionId String
  createdAt           DateTime    @default(now())
  business            Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer?   @relation(fields: [customerId], references: [id])
  supplier            Supplier?   @relation(fields: [supplierId], references: [id])
  sourceTransaction   Transaction @relation(fields: [sourceTransactionId], references: [id])
  events              DebtEvent[]

  @@index([businessId, status])
  @@index([businessId, status, createdAt])
  @@index([customerId, status])
  @@index([supplierId, status])
}

model DebtEvent {
  id        String        @id @default(cuid())
  type      DebtEventType
  amount    Decimal?
  note      String?
  channel   String?
  debtId    String
  actorId   String?
  createdAt DateTime      @default(now())
  debt      Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  actor     User?         @relation(fields: [actorId], references: [id])

  @@index([debtId, createdAt])
}

model InventoryItem {
  id             String              @id @default(cuid())
  name           String
  sku            String?
  sellingPrice   Decimal
  costPrice      Decimal
  quantityOnHand Int                 @default(0)
  lowStockLevel  Int                 @default(5)
  businessId     String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  transactions   Transaction[]

  @@unique([businessId, sku])
  @@index([businessId, updatedAt])
  @@index([businessId, createdAt])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  type          InventoryMovementType
  quantity      Int
  note          String?
  itemId        String
  accountId     String?
  transactionId String?
  createdAt     DateTime              @default(now())
  item          InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  account       Account?              @relation(fields: [accountId], references: [id])
  transaction   Transaction?          @relation(fields: [transactionId], references: [id])

  @@index([itemId, createdAt])
  @@index([accountId, createdAt])
}

model TaxRun {
  id         String    @id @default(cuid())
  month      Int
  year       Int
  vatRate    Decimal
  salesTotal Decimal
  vatTotal   Decimal
  status     TaxStatus @default(DRAFT)
  businessId String
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, month, year])
}

model ReportSnapshot {
  id          String   @id @default(cuid())
  period      String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  businessId  String
  actorId     String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorId], references: [id])

  @@index([businessId, periodStart, periodEnd])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  message    String
  metadata   Json?
  businessId String
  actorId    String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([businessId, createdAt])
}

model ApiErrorLog {
  id         String    @id @default(cuid())
  route      String
  method     String
  message    String
  code       String?
  businessId String?
  actorId    String?
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([route, createdAt])
}

model Receipt {
  id          String   @id @default(cuid())
  fileName    String
  mimeType    String?
  extractedAt DateTime @default(now())
  vendor      String?
  amount      Decimal?
  category    String?
  rawText     String?
  businessId  String
  actorId     String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Subscription {
  id                  String             @id @default(cuid())
  plan                SubscriptionPlan
  status              SubscriptionStatus @default(TRIALING)
  amountMonthlyKobo   Int
  amount              Int?
  reference           String?            @unique
  provider            String             @default("manual")
  providerCustomerId  String?
  providerSessionId   String?
  paystackAccessCode  String?
  paystackCheckoutUrl String?
  paidAt              DateTime?
  currentPeriodEnd    DateTime?
  businessId          String
  userId              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([userId, status])
}

model PaymentEvent {
  id          String   @id @default(cuid())
  reference   String   @unique
  eventType   String
  payload     Json
  processedAt DateTime @default(now())

  @@index([eventType, processedAt])
}

model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  email       String
  status      String    @default("pending")
  reason      String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  metadata    Json?

  @@index([userId])
  @@index([status])
}

model OfflineCapture {
  id          String    @id @default(cuid())
  clientId    String
  payload     Json
  status      String    @default("received")
  error       String?
  businessId  String
  actorId     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, clientId])
  @@index([businessId, createdAt])
}

model WhatsAppMessage {
  id           String    @id @default(cuid())
  type         String
  direction    String
  status       String?
  phone        String
  message      String
  templateName String?
  externalId   String?
  metadata     Json?
  businessId   String?
  actorId      String?
  createdAt    DateTime  @default(now())
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([phone, createdAt])
  @@index([externalId])
}

model WhatsAppEvent {
  id         String    @id @default(cuid())
  eventType  String
  payload    Json
  businessId String?
  externalId String?
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([eventType, createdAt])
  @@index([externalId])
}

model MessagePreference {
  id              String   @id @default(cuid())
  businessId      String   @unique
  remindersEnabled Boolean @default(true)
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String   @default("Africa/Lagos")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AssistantThread {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  title      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AssistantMessage[]

  @@index([businessId])
  @@index([userId])
}

model AssistantMessage {
  id        String          @id @default(cuid())
  threadId  String
  userId    String?
  role      String
  content   String
  metadata  Json?
  createdAt DateTime        @default(now())
  thread    AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@index([threadId, createdAt])
}

model AutomationPreference {
  id                         String   @id @default(cuid())
  businessId                 String   @unique
  dailyReminderEnabled       Boolean  @default(false)
  dailyReminderTime          String?
  debtReminderEnabled        Boolean  @default(false)
  lowStockAlertEnabled       Boolean  @default(true)
  weeklySummaryEnabled       Boolean  @default(false)
  whatsappAutomationEnabled  Boolean  @default(false)
  quietHoursStart            String?
  quietHoursEnd              String?
  timezone                   String   @default("Africa/Lagos")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  business                   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AutomationLog {
  id         String   @id @default(cuid())
  businessId String
  type       String
  status     String
  message    String?
  metadata   Json?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, type, createdAt])
  @@index([type])
  @@index([status])
}

model PendingAssistantAction {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  type       String
  payload    Json
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@index([businessId, status, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

enum Role {
  OWNER
  STAFF
  ACCOUNTANT
}

enum AccountType {
  CASH
  BANK
  POS
  MOBILE_MONEY
}

enum TransactionType {
  SALE
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum PaymentStatus {
  PAID
  CREDIT
  UNPAID
}

enum DebtType {
  CUSTOMER_OWES_BUSINESS
  BUSINESS_OWES_SUPPLIER
}

enum DebtStatus {
  OPEN
  SETTLED
}

enum DebtEventType {
  REMINDER
  CUSTOMER_COLLECTION
  SUPPLIER_SETTLEMENT
  NOTE
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum TaxStatus {
  DRAFT
  FINAL
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
